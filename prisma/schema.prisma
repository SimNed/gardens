generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id               String         @id @default(uuid())
  taxonomicName    String         @unique @db.VarChar(255)
  commonName       String         @unique @db.VarChar(255)
  genusId          String         @db.VarChar(255)
  plantCategoryId  String?        @db.VarChar(255)
  coldHardiness    Int
  soils            Soil[]
  lifeCycle        LifeCycle
  cultureLifeCycle LifeCycle?
  origin           String         @db.VarChar(255)
  sunExposure      SunExposure
  waterNeed        WaterNeed
  melliferous      Melliferous
  description      String
  cultureMonths    Month[]
  harvestMonths    Month[]
  imageUrl         String         @db.VarChar(255)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  published        Boolean        @default(false)
  genus            Genus          @relation(fields: [genusId], references: [id])
  plantCategory    PlantCategory? @relation(fields: [plantCategoryId], references: [id])
  diseases         Disease[]      @relation("DiseaseToPlant")
  pests            Pest[]         @relation("PestToPlant")
}

model Family {
  id          String  @id @default(uuid())
  label       String  @unique @db.VarChar(255)
  description String?
  genuses     Genus[]
}

model Genus {
  id          String  @id @default(uuid())
  label       String  @unique @db.VarChar(255)
  description String?
  familyId    String
  family      Family  @relation(fields: [familyId], references: [id])
  plants      Plant[]
}

model PlantCategory {
  id     String  @id @default(uuid())
  label  String  @unique @db.VarChar(255)
  plants Plant[]
}

model Pest {
  id          String   @id @default(uuid())
  label       String   @unique @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(false)
  plants      Plant[]  @relation("PestToPlant")
}

model Disease {
  id          String   @id @default(uuid())
  label       String   @unique @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(false)
  plants      Plant[]  @relation("DiseaseToPlant")
}

enum Soil {
  SANDY
  LOAMY
  CLAY
  HUMUS
}

enum LifeCycle {
  ANNUAL
  BISANNUAL
  PERENNIAL
}

enum SunExposure {
  SHADE
  PARTIAL_SHADE
  FULL_SUN
}

enum WaterNeed {
  LOW
  MODERATE
  HIGH
}

enum Melliferous {
  LOW
  MODERATE
  HIGH
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}
